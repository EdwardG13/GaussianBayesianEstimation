Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"p", "[", "\[Theta]_", "]"}], ":=", 
    RowBox[{"PDF", "[", 
     RowBox[{
      RowBox[{"NormalDistribution", "[", 
       RowBox[{"\[Mu]0", ",", "\[Sigma]0"}], "]"}], ",", "\[Theta]"}], 
     "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"First", " ", "moments"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"avgx\[Phi]0", "=", 
   RowBox[{"Integrate", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"x", "*", 
          RowBox[{"Cos", "[", "\[Phi]", "]"}]}], "+", 
         RowBox[{"q", "*", 
          RowBox[{"Sin", "[", "\[Phi]", "]"}]}]}], " ", ")"}], 
       RowBox[{"p", "[", "\[Theta]", "]"}]}], "/.", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"x", "->", 
         RowBox[{"x0", "*", 
          RowBox[{"Exp", "[", 
           RowBox[{"-", "\[Theta]"}], "]"}]}]}], ",", 
        RowBox[{"q", "->", 
         RowBox[{"p0", "*", 
          RowBox[{"Exp", "[", "\[Theta]", "]"}]}]}]}], "}"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Theta]", ",", 
       RowBox[{"-", "Infinity"}], ",", "Infinity"}], "}"}], ",", 
     RowBox[{"Assumptions", "->", 
      RowBox[{"\[Sigma]0", ">", "0"}]}]}], "]"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Gx\[Phi]x\[Phi]", "=", 
    RowBox[{
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"Expand", "[", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{
              RowBox[{"x", "*", 
               RowBox[{"Cos", "[", "\[Phi]", "]"}]}], "+", 
              RowBox[{"q", "*", 
               RowBox[{"Sin", "[", "\[Phi]", "]"}]}], "-", "avgx\[Phi]0"}], 
             ")"}], "2"], "]"}], ")"}], " ", 
         RowBox[{"p", "[", "\[Theta]", "]"}]}], "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           SuperscriptBox["x", "2"], "->", 
           RowBox[{
            RowBox[{"Exp", "[", 
             RowBox[{
              RowBox[{"-", "2"}], "\[Theta]"}], "]"}], "*", 
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox["x0", "2"], "+", "Vxx"}], ")"}]}]}], ",", 
          RowBox[{"x", "->", 
           RowBox[{"x0", "*", 
            RowBox[{"Exp", "[", 
             RowBox[{"-", "\[Theta]"}], "]"}]}]}], ",", 
          RowBox[{
           SuperscriptBox["q", "2"], "->", 
           RowBox[{
            RowBox[{"Exp", "[", 
             RowBox[{"2", "\[Theta]"}], "]"}], "*", 
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox["p0", "2"], "+", "Vpp"}], ")"}]}]}], ",", 
          RowBox[{"q", "->", 
           RowBox[{"p0", "*", 
            RowBox[{"Exp", "[", "\[Theta]", "]"}]}]}]}], "}"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Theta]", ",", 
         RowBox[{"-", "Infinity"}], ",", "Infinity"}], "}"}], ",", 
       RowBox[{"Assumptions", "->", 
        RowBox[{"\[Sigma]0", ">", "0"}]}]}], "]"}], "//", "Simplify"}]}], 
   ";"}], "\[IndentingNewLine]", "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Gram", " ", "matrix"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Gmat", "=", 
