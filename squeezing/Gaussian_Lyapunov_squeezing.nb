Cell[TextData[{
 "Use the linear basis ",
 Cell[BoxData[
  FormBox[
   RowBox[{"B", "=", 
    RowBox[{"{", 
     RowBox[{"1", ",", 
      SubscriptBox["\[CapitalDelta]x", "\[Phi]"]}]}]}], TraditionalForm]],
  ExpressionUUID->"78db656e-6e2e-f64b-bb71-76d3f68e4385"],
 "} where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalDelta]x", "\[Phi]"], "=", 
    RowBox[{
     OverscriptBox[
      SubscriptBox["x", "\[Phi]"], "^"], "-", 
     RowBox[{"Tr", "(", 
      RowBox[{
       SubscriptBox["\[Rho]", "0"], 
       OverscriptBox[
        SubscriptBox["x", "\[Phi]"], "^"]}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"41594554-b361-a247-871b-281ae927b5de"],
 "."
}], "Text",
