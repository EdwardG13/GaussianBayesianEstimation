Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Now", " ", "calculate", " ", "the", " ", "constrained", " ", "MSL", " ", 
     "\[ScriptCapitalL]", 
     RowBox[{"(", 
      SubscriptBox["\[ScriptCapitalS]", "\[ScriptCapitalV]"], ")"}]}], "=", 
    RowBox[{"\[Lambda]", "-", 
     RowBox[{
      SuperscriptBox["b", "T"], 
      SuperscriptBox["G", 
       RowBox[{"-", "1"}]], "b"}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Lambda]", "=", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{
        SuperscriptBox["\[Theta]", "2"], " ", 
        RowBox[{"p", "[", "\[Theta]", "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Theta]", ",", 
         RowBox[{"-", "Infinity"}], ",", "Infinity"}], "}"}], ",", 
       RowBox[{"Assumptions", "->", 
        RowBox[{"\[Sigma]0", ">", "0"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
