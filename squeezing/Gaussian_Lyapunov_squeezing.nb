Cell[BoxData[
 RowBox[{
  SuperscriptBox["\[Sigma]0", "2"], "-", 
  FractionBox[
   RowBox[{"2", " ", 
    SuperscriptBox["\[Sigma]0", "4"], " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{"4", " ", "\[Mu]0"}]]}], " ", "Vpp"}], "+", "Vxx", "+", 
       RowBox[{
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"4", " ", "\[Mu]0"}]], " ", "Vpp", " ", 
        RowBox[{"Cos", "[", 
         RowBox[{"2", " ", "\[Phi]"}], "]"}]}], "+", 
       RowBox[{"Vxx", " ", 
        RowBox[{"Cos", "[", 
         RowBox[{"2", " ", "\[Phi]"}], "]"}]}]}], ")"}], "2"]}], 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"4", " ", "\[Mu]0"}]]}], " ", "Vpp"}], "-", "Vxx", "+", 
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"4", " ", "\[Mu]0"}]], " ", "Vpp", " ", 
       RowBox[{"Cos", "[", 
        RowBox[{"2", " ", "\[Phi]"}], "]"}]}], "-", 
      RowBox[{"Vxx", " ", 
       RowBox[{"Cos", "[", 
        RowBox[{"2", " ", "\[Phi]"}], "]"}]}]}], ")"}], "2"]]}]], "Output",
 CellChangeTimes->{{3.9837011137955914`*^9, 3.983701146455448*^9}, 
   3.983702084158863*^9, 3.983775901258621*^9, 3.98379094517906*^9, 
