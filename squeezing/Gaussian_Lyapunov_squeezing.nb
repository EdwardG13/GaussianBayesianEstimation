1842f51bb9b8"],

Cell[TextData[{
 "Use the quadratic centred basis ",
 Cell[BoxData[
  FormBox[
   RowBox[{"B", "=", 
    RowBox[{"{", 
     RowBox[{"1", ",", 
      SuperscriptBox["\[CapitalDelta]x", "2"]}]}]}], TraditionalForm]],
  ExpressionUUID->"99a5115a-6cca-764b-9b93-b3987a2225be"],
 "} with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[CapitalDelta]x", "2"], "=", 
    RowBox[{
     SuperscriptBox[
      OverscriptBox["x", "^"], "2"], "-", 
     RowBox[{"Tr", "(", 
      RowBox[{
       SubscriptBox["\[Rho]", "0"], 
       SuperscriptBox[
        OverscriptBox["x", "^"], "2"]}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"713c1e36-9824-064f-9669-9deba9047115"]
}], "Text",
