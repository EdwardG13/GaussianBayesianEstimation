Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"InfoGainSqueezedDisplaced", "[", 
   RowBox[{
   "\[Mu]0_", ",", "\[Sigma]0_", ",", "\[Mu]_", ",", "\[Phi]_", ",", "r_"}], 
   "]"}], "=", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Lambda]", "-", "MSL"}], "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Vxx", "->", 
       RowBox[{"Exp", "[", 
        RowBox[{"2", "r"}], "]"}]}], ",", 
      RowBox[{"Vpp", "->", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "2"}], "r"}], "]"}]}], ",", 
      RowBox[{"\[Mu]x", "->", 
       RowBox[{"\[Mu]", "*", 
        RowBox[{"Cos", "[", "\[Phi]", "]"}]}]}], ",", 
      RowBox[{"\[Mu]p", "->", 
       RowBox[{"\[Mu]", "*", 
        RowBox[{"Sin", "[", "\[Phi]", "]"}]}]}]}], "}"}]}], "//", 
   "Simplify"}]}]], "Input",
 CellChangeTimes->{{3.9829141711355305`*^9, 3.9829142575217457`*^9}, 
   3.982914290247967*^9, {3.9829146962236233`*^9, 3.982914708196394*^9}, {
