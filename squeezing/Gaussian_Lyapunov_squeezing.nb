Cell["Determine the stationary points of the MSL w.r.t \[Phi]", "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.9837914614804363`*^9, 3.9837914790507145`*^9}, {
  3.983792428187763*^9, 3.983792442448372*^9}},
 Background->RGBColor[
  0.67, 0.54, 0.42, 
   0.33],ExpressionUUID->"eb2020bc-f0cc-384d-ac3a-f1780ce08f91"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Solve", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"MSL1x\[Phi]", "[", 
        RowBox[{
        "\[Phi]", ",", "\[Mu]0", ",", "\[Sigma]0", ",", "x0", ",", "p0", ",", 
         "Vxx", ",", "Vpp"}], "]"}], ",", "\[Phi]"}], "]"}], "==", "0"}], ",",
     "\[Phi]"}], "]"}], "//", "FullSimplify"}]], "Input",
 CellChangeTimes->{{3.983791444272564*^9, 3.9837915052503624`*^9}, 
   3.9837915712769165`*^9},
 CellLabel->
  "In[1551]:=",ExpressionUUID->"9e1b630a-f38b-8141-af69-c4cc7b2064da"],

Cell[BoxData[
 TemplateBox[{
  "Solve", "ifun", 
   "\"Inverse functions are being used by \
\\!\\(\\*RowBox[{\\\"Solve\\\"}]\\), so some solutions may not be found; use \
Reduce for complete solution information.\"", 2, 1551, 26, 
   18861980533148764401, "Local"},
  "MessageTemplate",
  BaseStyle->"MSG"]], "Message",
 CellChangeTimes->{3.983791455003666*^9, 3.9837915121400185`*^9, 
  3.983791578110916*^9},
 CellLabel->
  "During evaluation of \
In[1551]:=",ExpressionUUID->"f77639b3-4588-574d-8945-1dd277ba591f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\[Phi]", "\[Rule]", 
     RowBox[{"-", 
      RowBox[{"ArcCos", "[", 
       RowBox[{"-", 
        FractionBox[
