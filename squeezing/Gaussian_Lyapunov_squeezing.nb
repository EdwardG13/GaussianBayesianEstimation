Cell[CellGroupData[{

Cell["Symmetric logarithmic derivative (SLD)", "Section",
 CellChangeTimes->{{3.6520949429746923`*^9, 
  3.652094951849272*^9}},ExpressionUUID->"029b1340-2682-2248-aba5-\
02df89d4e50e"],

Cell[TextData[{
 "We want to obtain the symmetric logarithmic derivative. For a Gaussian \
state, it is a quadratic form of position and momentum (",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "f99d9d0e-9838-b44d-b08e-4356bf181c83"],
 " and ",
 Cell[BoxData[
  FormBox["p", TraditionalForm]],ExpressionUUID->
  "0d11133b-8842-8a45-8cdb-953c80554979"],
 ") \n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[ScriptCapitalL]", "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[Sum]", "ij"], " ", 
      RowBox[{
       SubscriptBox["L", "ij"], " ", 
       FractionBox["1", "2"], 
       SubscriptBox[
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           SubscriptBox["R", "i"], "-", 
           SubscriptBox["d", "i"]}], ",", 
          RowBox[{
           SubscriptBox["R", "j"], "-", 
           SubscriptBox["d", "j"]}]}], "}"}], "+"]}]}], "+", 
     RowBox[{
      SubscriptBox["\[Sum]", "i"], 
      RowBox[{
       SubscriptBox["b", "i"], "(", 
       RowBox[{
        SubscriptBox["R", "i"], "-", 
        SubscriptBox["d", "i"]}], ")"}]}], "-", 
     RowBox[{
      FractionBox["1", "2"], "tr", 
      RowBox[{"{", 
       StyleBox[
        RowBox[{"L", " ", "\[CapitalGamma]"}],
        FontWeight->"Bold"], "}"}]}]}]}], TraditionalForm]],ExpressionUUID->
  "943f45ff-f781-f34a-a6a4-060de4447e02"],
 ",\n\nhere, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["d", "i"], "=", 
    RowBox[{
     RowBox[{"\[LeftAngleBracket]", 
      SubscriptBox["R", "i"], "\[RightAngleBracket]"}], "=", 
     RowBox[{"tr", 
      RowBox[{"{", 
       RowBox[{
        SubscriptBox["R", "i"], "\[Rho]"}], "}"}]}]}]}], TraditionalForm]],
  ExpressionUUID->"84733a7e-e200-a547-be49-38360508244d"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["R", "\[Rule]"], "=", 
    RowBox[{"(", 
     RowBox[{"x", ",", "p"}], ")"}]}], TraditionalForm]],ExpressionUUID->
  "cf583360-f7dd-144b-a5a7-0a72ed629421"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["\[CapitalGamma]",
     FontWeight->"Bold"], "=", 
    RowBox[{"2", 
     StyleBox["\[Sigma]",
      FontWeight->"Bold"]}]}], TraditionalForm]],ExpressionUUID->
  "e5db91ef-6707-4547-8bdd-b67f8df80faa"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Sigma]", "ij"], "=", 
    RowBox[{
     FractionBox["1", "2"], 
     RowBox[{"\[LeftAngleBracket]", 
      SubscriptBox[
       RowBox[{"{", 
        RowBox[{
         SubscriptBox["R", "i"], ",", 
         SubscriptBox["R", "j"]}], "}"}], "+"], "\[RightAngleBracket]"}]}]}], 
   TraditionalForm]],ExpressionUUID->"3a7d3ecc-00dc-6547-9374-909bb75e99d1"],
 " are the elements of the (symmetrized) covariance matrix. See Monras (2013) \
https://arxiv.org/pdf/1303.3682."
}], "Text",
 CellChangeTimes->{{3.6522528959283752`*^9, 3.6522528997803583`*^9}, {
  3.652252984348523*^9, 3.652252986882021*^9}, {3.9817898712708893`*^9, 
  3.981789900635914*^9}},
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"618f600b-c654-3d49-a2fc-e4e583f698ee"],

Cell[TextData[{
 "Here, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["\[CapitalOmega]",
     FontWeight->"Bold"], "=", 
    RowBox[{"(", GridBox[{
       {"0", 
        RowBox[{"-", "1"}]},
       {"1", "0"}
      }], ")"}]}], TraditionalForm]],ExpressionUUID->
  "cc7bcebb-5129-c94e-bab9-80a1f5949e6f"],
 " is the symplectic matrix. \n\nThe coefficients are given by\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["L",
     FontWeight->"Bold"], "=", 
    RowBox[{
     SuperscriptBox[
      SubscriptBox["\[ScriptCapitalD]", 
       StyleBox["\[CapitalGamma]",
        FontWeight->"Bold"]], 
      RowBox[{"-", "1"}]], "(", 
     RowBox[{"\[PartialD]", 
      StyleBox["\[CapitalGamma]",
       FontWeight->"Bold"]}], ")"}]}], TraditionalForm]],ExpressionUUID->
  "f9aceb0d-7dd8-5847-9a2e-0155a0ae2d52"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["b", "\[Rule]"], "=", 
    RowBox[{"2", 
     SuperscriptBox[
      StyleBox["\[CapitalGamma]",
       FontWeight->"Bold"], 
      RowBox[{"-", "1"}]], 
     RowBox[{"\[PartialD]", 
      OverscriptBox["d", "\[Rule]"]}]}]}], TraditionalForm]],ExpressionUUID->
  "cbdbf4d2-77db-fa43-bbed-c29ecc1dc91b"],
 ",\n\nwhere the application ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["\[ScriptCapitalD]", 
       StyleBox["\[CapitalGamma]",
        FontWeight->"Bold"]], "(", 
      StyleBox["Y",
       FontWeight->"Bold"], ")"}], "=", 
     RowBox[{
      RowBox[{
       StyleBox["\[CapitalGamma]",
        FontWeight->"Bold"], " ", 
       StyleBox["Y",
        FontWeight->"Bold"], " ", 
       SuperscriptBox[
        StyleBox["\[CapitalGamma]",
         FontWeight->"Bold"], "T"]}], "-", 
      RowBox[{
       StyleBox["\[CapitalOmega]",
        FontWeight->"Bold"], " ", 
       StyleBox["Y",
        FontWeight->"Bold"], " ", 
       SuperscriptBox[
        StyleBox["\[CapitalOmega]",
         FontWeight->"Bold"], "T"]}]}]}], ","}], TraditionalForm]],
  ExpressionUUID->"d7edfd30-935b-844c-91b0-6ea5655e58ed"],
 " and \[PartialD] is a shorthand for \[PartialD]/\[PartialD]\[Theta]. Hence, \
",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     SubscriptBox["\[ScriptCapitalD]", 
      StyleBox["\[CapitalGamma]",
       FontWeight->"Bold"]], 
     RowBox[{"-", "1"}]], "(", 
    RowBox[{"\[PartialD]", 
     StyleBox["\[CapitalGamma]",
      FontWeight->"Bold"]}], ")"}], TraditionalForm]],ExpressionUUID->
  "2a66fadf-f4c0-8045-9510-0f1236163cea"],
 " is the solution ",
 StyleBox["Y",
  FontWeight->"Bold"],
 " to the matrix equation\n\n",
 Cell[BoxData[{
  FormBox[
   RowBox[{
    RowBox[{"\[PartialD]", 
     StyleBox["\[CapitalGamma]",
      FontWeight->"Bold"]}], "=", 
    RowBox[{
     RowBox[{
      StyleBox["\[CapitalGamma]",
       FontWeight->"Bold"], " ", 
      StyleBox["Y",
       FontWeight->"Bold"], " ", 
      SuperscriptBox[
       StyleBox["\[CapitalGamma]",
        FontWeight->"Bold"], "T"]}], "-", 
     RowBox[{
      StyleBox["\[CapitalOmega]",
       FontWeight->"Bold"], " ", 
      StyleBox["Y",
       FontWeight->"Bold"], " ", 
      SuperscriptBox[
       StyleBox["\[CapitalOmega]",
        FontWeight->"Bold"], "T"]}]}]}], TraditionalForm], "\[IndentingNewLine]", 
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox[
      StyleBox["\[CapitalOmega]",
       FontWeight->"Bold"], 
      RowBox[{"-", "1"}]], 
     RowBox[{"\[PartialD]", 
      StyleBox["\[CapitalGamma]",
       FontWeight->"Bold"]}], " ", 
     SuperscriptBox[
      RowBox[{"(", 
       SuperscriptBox[
        StyleBox["\[CapitalOmega]",
         FontWeight->"Bold"], "T"], ")"}], 
      RowBox[{"-", "1"}]]}], "=", 
    RowBox[{
     RowBox[{
      SuperscriptBox[
       StyleBox["\[CapitalOmega]",
        FontWeight->"Bold"], 
       RowBox[{"-", "1"}]], 
      StyleBox["\[CapitalGamma]",
       FontWeight->"Bold"], " ", 
      StyleBox["Y",
       FontWeight->"Bold"], " ", 
      SuperscriptBox[
       RowBox[{
        SuperscriptBox[
         StyleBox["\[CapitalGamma]",
          FontWeight->"Bold"], "T"], "(", 
        SuperscriptBox[
         StyleBox["\[CapitalOmega]",
          FontWeight->"Bold"], "T"], ")"}], 
       RowBox[{"-", "1"}]]}], "-", 
     StyleBox["Y",
      FontWeight->"Bold"]}]}], TraditionalForm], "\[IndentingNewLine]", 
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox[
      StyleBox["\[CapitalOmega]",
       FontWeight->"Bold"], "T"], 
     RowBox[{"\[PartialD]", 
      StyleBox["\[CapitalGamma]",
       FontWeight->"Bold"]}], 
     StyleBox[" ",
      FontWeight->"Bold"], 
     StyleBox["\[CapitalOmega]",
      FontWeight->"Bold"]}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox[
         StyleBox["\[CapitalOmega]",
          FontWeight->"Bold"], "T"], 
        StyleBox["\[CapitalGamma]",
         FontWeight->"Bold"]}], ")"}], 
      SuperscriptBox[
       RowBox[{
        StyleBox["Y",
         FontWeight->"Bold"], "(", 
        RowBox[{
         SuperscriptBox[
          StyleBox["\[CapitalOmega]",
           FontWeight->"Bold"], "T"], 
         StyleBox["\[CapitalGamma]",
          FontWeight->"Bold"]}], ")"}], "T"]}], "-", 
     StyleBox["Y",
      FontWeight->"Bold"]}]}], TraditionalForm], "\[IndentingNewLine]", 
  FormBox[
   RowBox[{
    RowBox[{
     StyleBox["Y",
      FontWeight->"Bold"], 
     StyleBox["-",
      FontWeight->"Bold"], 
     RowBox[{
      StyleBox["F",
       FontWeight->"Bold"], 
      StyleBox[" ",
       FontWeight->"Bold"], 
      StyleBox["Y",
       FontWeight->"Bold"], 
      StyleBox[" ",
       FontWeight->"Bold"], 
      SuperscriptBox[
       StyleBox["F",
        FontWeight->"Bold"], "T"]}]}], "=", 
    RowBox[{
     RowBox[{
      StyleBox["-",
       FontWeight->"Bold"], 
      SuperscriptBox[
       StyleBox["\[CapitalOmega]",
        FontWeight->"Bold"], "T"]}], 
     RowBox[{"\[PartialD]", 
      StyleBox["\[CapitalGamma]",
       FontWeight->"Bold"]}], 
     StyleBox[" ",
      FontWeight->"Bold"], 
     RowBox[{
      StyleBox["\[CapitalOmega]",
       FontWeight->"Bold"], "."}]}]}], TraditionalForm]}],ExpressionUUID->
  "d7c7d367-dd8d-df45-a011-dc8e7804118d"],
 "\n\nIn our case, we have"
}], "Text",
 CellChangeTimes->{{3.652253037031055*^9, 3.6522530522470703`*^9}, {
   3.6522532310445347`*^9, 3.6522532336786747`*^9}, 3.652254652824998*^9, {
   3.9816108863991127`*^9, 3.981610887282446*^9}, {3.9817899058560505`*^9, 
   3.981789906638445*^9}},
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"912331ed-3fab-d040-8393-2a56f1acb017"],

Cell[BoxData[
 RowBox[{
  RowBox[{"covSqueezed", "[", "\[Theta]_", "]"}], ":=", 
  RowBox[{"(", GridBox[{
     {
      RowBox[{"Vxx", "*", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "2"}], "\[Theta]"}], "]"}]}], "Vxp"},
     {"Vxp", 
      RowBox[{"Vpp", "*", 
       RowBox[{"Exp", "[", 
        RowBox[{"2", "\[Theta]"}], "]"}]}]}
    }], ")"}]}]], "Input",
 CellChangeTimes->{{3.981609611400915*^9, 3.981609675665804*^9}, {
  3.9816109359989243`*^9, 3.9816109367040615`*^9}, {3.9836066740175686`*^9, 
  3.9836066815860825`*^9}},
 CellLabel->
  "In[258]:=",ExpressionUUID->"ae4f24bd-cbea-4b4c-97b8-3a820d199a84"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"mL", "=", 
   RowBox[{"(", GridBox[{
      {
       RowBox[{"L", "[", 
        RowBox[{"1", ",", "1"}], "]"}], 
       RowBox[{"L", "[", 
        RowBox[{"1", ",", "2"}], "]"}]},
      {
       RowBox[{"L", "[", 
        RowBox[{"2", ",", "1"}], "]"}], 
       RowBox[{"L", "[", 
        RowBox[{"2", ",", "2"}], "]"}]}
     }], ")"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalGamma]", "=", 
   RowBox[{"2", 
    RowBox[{"covSqueezed", "[", "\[Theta]", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"d\[CapitalGamma]", "=", 
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"2", 
       RowBox[{"covSqueezed", "[", "\[Theta]", "]"}]}], ",", "\[Theta]"}], 
     "]"}], "//", "FullSimplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalOmega]", "=", 
   RowBox[{"(", GridBox[{
      {"0", 
       RowBox[{"-", "1"}]},
      {"1", "0"}
     }], ")"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"F", "=", 
   RowBox[{
    RowBox[{"Transpose", "[", "\[CapitalOmega]", "]"}], ".", 
    "\[CapitalGamma]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.652253611555421*^9, 3.652253682247488*^9}, {
  3.652253722358612*^9, 3.652253756821752*^9}, {3.652253844812969*^9, 
  3.6522538490486593`*^9}, {3.652254023653514*^9, 3.6522540238038683`*^9}, {
  3.981609683549141*^9, 3.981609692921295*^9}},
 CellLabel->
  "In[259]:=",ExpressionUUID->"0a6283d5-2503-1343-873b-28b9be774f7a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"sol", "=", 
   RowBox[{
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Flatten", "[", 
           RowBox[{"mL", "-", 
            RowBox[{"F", ".", "mL", ".", 
             RowBox[{"Transpose", "[", "F", "]"}]}]}], "]"}], "\[LeftDoubleBracket]",
           "#", "\[RightDoubleBracket]"}], "\[Equal]", 
         RowBox[{
          RowBox[{"Flatten", "[", 
           RowBox[{"-", 
            RowBox[{
             RowBox[{"Transpose", "[", "\[CapitalOmega]", "]"}], ".", 
             "d\[CapitalGamma]", ".", "\[CapitalOmega]"}]}], "]"}], "\[LeftDoubleBracket]",
           "#", "\[RightDoubleBracket]"}]}], "&"}], "/@", 
       RowBox[{"Range", "[", "4", "]"}]}], ",", 
      RowBox[{"Flatten", "[", "mL", "]"}]}], "]"}], "//", "FullSimplify"}]}], 
  ";", 
  RowBox[{
   RowBox[{
    RowBox[{"mL", "/.", 
     RowBox[{"Flatten", "[", "sol", "]"}]}], "//", "MatrixForm"}], "//", 
   "TraditionalForm"}]}]], "Input",
 CellLabel->
  "In[264]:=",ExpressionUUID->"a432ba36-eb7b-1943-bfdf-7580a8494c3c"],

Cell[BoxData[
 FormBox[
  TagBox[
   RowBox[{"(", "\[NoBreak]", GridBox[{
      {
       RowBox[{"-", 
        FractionBox[
         RowBox[{"4", " ", 
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{"2", " ", "\[Theta]"}]], " ", "Vpp"}], 
         RowBox[{
          RowBox[{"4", " ", "Vpp", " ", "Vxx"}], "-", 
          RowBox[{"4", " ", 
           SuperscriptBox["Vxp", "2"]}], "+", "1"}]]}], "0"},
      {"0", 
       FractionBox[
        RowBox[{"4", " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           RowBox[{"-", "2"}], " ", "\[Theta]"}]], " ", "Vxx"}], 
        RowBox[{
         RowBox[{"4", " ", "Vpp", " ", "Vxx"}], "-", 
         RowBox[{"4", " ", 
          SuperscriptBox["Vxp", "2"]}], "+", "1"}]]}
     },
     GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
     GridBoxSpacings->{"Columns" -> {
         Offset[0.27999999999999997`], {
          Offset[0.7]}, 
         Offset[0.27999999999999997`]}, "Rows" -> {
         Offset[0.2], {
          Offset[0.4]}, 
         Offset[0.2]}}], "\[NoBreak]", ")"}],
   Function[BoxForm`e$, 
    MatrixForm[BoxForm`e$]]], TraditionalForm]], "Output",
 CellChangeTimes->{{3.9816097824001293`*^9, 3.981609790457052*^9}, 
   3.9816109463821735`*^9, 3.982912470870619*^9, 3.9836062766493607`*^9, 
   3.98360668538208*^9},
 CellLabel->
  "Out[264]//TraditionalForm=",ExpressionUUID->"5f3b34e2-2d43-4743-888b-\
3cb449e9b994"]
}, Open  ]],

Cell[TextData[{
 "Note that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     StyleBox["Y",
      FontWeight->"Bold"], 
     StyleBox["-",
      FontWeight->"Bold"], 
     RowBox[{
      StyleBox["F",
       FontWeight->"Bold"], 
      StyleBox[" ",
       FontWeight->"Bold"], 
      StyleBox["Y",
       FontWeight->"Bold"], 
      StyleBox[" ",
       FontWeight->"Bold"], 
      SuperscriptBox[
       StyleBox["F",
        FontWeight->"Bold"], "T"]}]}], "=", 
    RowBox[{
     RowBox[{
      StyleBox["-",
       FontWeight->"Bold"], 
      SuperscriptBox[
       StyleBox["\[CapitalOmega]",
        FontWeight->"Bold"], "T"]}], 
     RowBox[{"\[PartialD]", 
      StyleBox["\[CapitalGamma]",
       FontWeight->"Bold"]}], 
     StyleBox[" ",
      FontWeight->"Bold"], 
     StyleBox["\[CapitalOmega]",
      FontWeight->"Bold"]}]}], TraditionalForm]],ExpressionUUID->
  "fc55b430-4b9b-3447-bc44-c6b18cc281f9"],
 " is a discrete-time Lyapunov equation, whose solution is formally given by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Y",
     FontWeight->"Bold"], " ", "=", " ", 
    RowBox[{"-", 
     RowBox[{
      SubscriptBox["\[Sum]", "k"], 
      RowBox[{
       RowBox[{
        SuperscriptBox[
         StyleBox["F",
          FontWeight->"Bold"], "k"], "(", 
        RowBox[{
         SuperscriptBox[
          StyleBox["\[CapitalOmega]",
           FontWeight->"Bold"], "T"], 
         RowBox[{"\[PartialD]", 
          StyleBox["\[CapitalGamma]",
           FontWeight->"Bold"]}], 
         StyleBox[" ",
          FontWeight->"Bold"], 
         StyleBox["\[CapitalOmega]",
          FontWeight->"Bold"]}], ")"}], 
       RowBox[{
        SuperscriptBox[
         StyleBox["F",
          FontWeight->"Bold"], 
         RowBox[{"T", " ", "k"}]], "."}]}]}]}]}], TraditionalForm]],
  ExpressionUUID->"651f7fd4-68f2-394e-973d-6206da023629"],
 " "
}], "Text",
 CellChangeTimes->{{3.65225466084861*^9, 3.6522546980037537`*^9}, 
   3.9829124715893784`*^9},
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"84546f1d-ab7b-3346-ab00-4bb0621b1943"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"-", 
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{"FullSimplify", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"MatrixPower", "[", 
          RowBox[{"F", ",", "k"}], "]"}], ".", 
         RowBox[{"Transpose", "[", "\[CapitalOmega]", "]"}], ".", 
         "d\[CapitalGamma]", ".", "\[CapitalOmega]", ".", 
         RowBox[{"MatrixPower", "[", 
          RowBox[{
           RowBox[{"Transpose", "[", "F", "]"}], ",", "k"}], "]"}]}], ",", 
        RowBox[{"Assumptions", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"k", "\[Element]", "Integers"}], ",", 
           RowBox[{"k", ">", "0"}]}], "}"}]}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", "0", ",", "Infinity"}], "}"}]}], "]"}]}], "//", 
   "MatrixForm"}], "//", "TraditionalForm"}]], "Input",
 CellChangeTimes->{{3.652254708529702*^9, 3.652254819280356*^9}},
 CellLabel->
  "In[265]:=",ExpressionUUID->"3e8e394d-8ab8-544a-bea6-5fd95374412e"],

Cell[BoxData[
 FormBox[
  TagBox[
   RowBox[{"(", "\[NoBreak]", GridBox[{
      {
       RowBox[{"-", 
        FractionBox[
         RowBox[{"4", " ", 
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{"2", " ", "\[Theta]"}]], " ", "Vpp"}], 
         RowBox[{
          RowBox[{"4", " ", "Vpp", " ", "Vxx"}], "-", 
          RowBox[{"4", " ", 
           SuperscriptBox["Vxp", "2"]}], "+", "1"}]]}], "0"},
      {"0", 
       FractionBox[
        RowBox[{"4", " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           RowBox[{"-", "2"}], " ", "\[Theta]"}]], " ", "Vxx"}], 
        RowBox[{
         RowBox[{"4", " ", "Vpp", " ", "Vxx"}], "-", 
         RowBox[{"4", " ", 
          SuperscriptBox["Vxp", "2"]}], "+", "1"}]]}
     },
     GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
     GridBoxSpacings->{"Columns" -> {
         Offset[0.27999999999999997`], {
          Offset[0.7]}, 
         Offset[0.27999999999999997`]}, "Rows" -> {
         Offset[0.2], {
          Offset[0.4]}, 
         Offset[0.2]}}], "\[NoBreak]", ")"}],
   Function[BoxForm`e$, 
    MatrixForm[BoxForm`e$]]], TraditionalForm]], "Output",
 CellChangeTimes->{{3.652254776311376*^9, 3.652254820096714*^9}, 
   3.981609711401989*^9, 3.981609765015665*^9, 3.982912475366358*^9, 
   3.9836062818838444`*^9, 3.9836066881407585`*^9},
 CellLabel->
  "Out[265]//TraditionalForm=",ExpressionUUID->"0dde7542-b647-d848-94ae-\
22707e0b77e3"]
}, Open  ]],

Cell[TextData[{
 "The linear term ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["b", "\[Rule]"], "=", 
    RowBox[{"2", 
     SuperscriptBox[
      StyleBox["\[CapitalGamma]",
       FontWeight->"Bold"], 
      RowBox[{"-", "1"}]], 
     RowBox[{"\[PartialD]", 
      OverscriptBox["d", "\[Rule]"]}]}]}], TraditionalForm]],ExpressionUUID->
  "26d299ec-eeeb-b543-bd19-8aca450d0708"],
 " is"
}], "Text",
 CellChangeTimes->{{3.652254974177588*^9, 3.6522550474156857`*^9}, {
   3.652255231268901*^9, 3.6522552671706247`*^9}, 3.9816101486663265`*^9, {
   3.981612587475075*^9, 3.981612600882477*^9}},
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"49dfb25c-4a44-c043-abc4-ebe1edadff68"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Inverse", "[", "\[CapitalGamma]", "]"}], ".", 
   RowBox[{"D", "[", 
    RowBox[{
     RowBox[{"2", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"x0", "*", 
         RowBox[{"Exp", "[", 
          RowBox[{"-", "\[Theta]"}], "]"}]}], ",", 
        RowBox[{"p0", "*", 
         RowBox[{"Exp", "[", "\[Theta]", "]"}]}]}], "}"}]}], ",", 
     "\[Theta]"}], "]"}]}], "//", "FullSimplify"}]], "Input",
