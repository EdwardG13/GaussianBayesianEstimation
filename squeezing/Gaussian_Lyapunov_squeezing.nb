Cell[CellGroupData[{
Cell["\<\
A variational framework for near-optimal Bayesian quantum estimation of \
Gaussian states\
\>", "Title",
 CellChangeTimes->{{3.965299566043968*^9, 3.96529957198666*^9}, {
  3.9817899273408775`*^9, 3.9817899371702137`*^9}, {3.9836036259369793`*^9, 
  3.983603651352707*^9}},ExpressionUUID->"a3c39557-93f1-6444-ad8c-\
992a303c444c"],

Cell[TextData[{
 "This notebook contains symbolic calculations for estimation of a squeezing \
parameter encoded in the mean and/or covariances of a Gaussian state. \n\nIn \
the following we will take a Gaussian prior (since ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["rho", "0"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "fee72656-7a82-8749-a115-528312547373"],
 " is not a Gaussian state the true S will never \n\nLast updated: 27/03/26."
}], "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.98178892834478*^9, 3.9817889748943996`*^9}, {
  3.983601029699011*^9, 3.9836010300935383`*^9}, {3.9836036845302105`*^9, 
  3.9836037305863037`*^9}},
 Background->RGBColor[
  0.67, 0.54, 0.42, 
   0.33],ExpressionUUID->"a36505e2-339b-2541-b791-d83a8506d925"],

