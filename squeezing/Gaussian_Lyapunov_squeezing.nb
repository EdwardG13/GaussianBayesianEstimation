        RowBox[{"\[Sigma]0", ">", "0"}]}]}], "]"}], "//", "Simplify"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Build", " ", "quadratic", " ", "block"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"GmatBlock", "=", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"Gx2x2", ",", "Gx2p2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"Gx2p2", ",", "Gp2p2"}], "}"}]}], "}"}], "//", 
      "FullSimplify"}]}], ";"}], "\[IndentingNewLine]", 
