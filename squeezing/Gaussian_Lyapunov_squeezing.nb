  FractionBox[
   RowBox[{"2", " ", 
    SuperscriptBox["\[Sigma]0", "4"], " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{"4", " ", "\[Mu]0"}]]}], " ", "Vpp"}], "+", "Vxx", "+", 
       RowBox[{
