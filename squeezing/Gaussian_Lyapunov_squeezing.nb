      RowBox[{"\[Lambda]", "-", 
       RowBox[{"bvec", ".", 
        RowBox[{"Inverse", "[", "Gmat", "]"}], ".", "bvec"}]}], "]"}]}], 
    ";"}]}]}]], "Input",
