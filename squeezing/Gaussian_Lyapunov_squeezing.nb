  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalDelta]x", "\[Phi]"], "=", 
    RowBox[{
     OverscriptBox[
      SubscriptBox["x", "\[Phi]"], "^"], "-", 
     RowBox[{"Tr", "(", 
      RowBox[{
       SubscriptBox["\[Rho]", "0"], 
       OverscriptBox[
        SubscriptBox["x", "\[Phi]"], "^"]}], ")"}]}]}], TraditionalForm]],
