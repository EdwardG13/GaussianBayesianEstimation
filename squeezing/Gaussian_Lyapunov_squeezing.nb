Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Gxx", "=", 
    RowBox[{
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"Expand", "[", 
           SuperscriptBox[
            RowBox[{"(", "x", ")"}], "2"], "]"}], ")"}], " ", 
         RowBox[{"p", "[", "\[Theta]", "]"}]}], "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           SuperscriptBox["x", "2"], "->", 
           RowBox[{
            RowBox[{"Exp", "[", 
             RowBox[{
              RowBox[{"-", "2"}], " ", "\[Theta]"}], "]"}], 
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox["x0", "2"], "+", "Vxx"}], ")"}]}]}], " ", ",", 
          RowBox[{"x", "->", 
           RowBox[{"x0", "*", 
            RowBox[{"Exp", "[", 
             RowBox[{"-", "\[Theta]"}], "]"}]}]}]}], "}"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Theta]", ",", 
         RowBox[{"-", "Infinity"}], ",", "Infinity"}], "}"}], ",", 
       RowBox[{"Assumptions", "->", 
        RowBox[{"\[Sigma]0", ">", "0"}]}]}], "]"}], "//", "Simplify"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"Gx2x2", "=", 
    RowBox[{
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"(", 
