Cell[TextData[{
 "Use the quadratic centred basis ",
 Cell[BoxData[
  FormBox[
   RowBox[{"B", "=", 
    RowBox[{"{", 
     RowBox[{"1", ",", 
      SuperscriptBox["\[CapitalDelta]x", "2"], ",", 
      SuperscriptBox["\[CapitalDelta]p", "2"]}]}]}], TraditionalForm]],
  ExpressionUUID->"d4747abc-c6db-3342-8224-cdc63a2d1352"],
 "} with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[CapitalDelta]x", "2"], "=", 
    RowBox[{
     SuperscriptBox[
      OverscriptBox["x", "^"], "2"], "-", 
     RowBox[{"Tr", "(", 
      RowBox[{
       SubscriptBox["\[Rho]", "0"], 
       SuperscriptBox[
        OverscriptBox["x", "^"], "2"]}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"f456a232-9f37-9549-aedd-8723d7659250"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[CapitalDelta]p", "2"], "=", 
    RowBox[{
     SuperscriptBox[
