   RowBox[{"bx", "=", 
    RowBox[{
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"\[Theta]", "*", 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["x", "2"], "-", "avgx2\[Rho]0"}], ")"}], " ", 
