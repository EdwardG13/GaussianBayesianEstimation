           RowBox[{"avgx2\[Rho]0", "*", "avgp2\[Rho]0"}]}], "]"}], " ", 
         RowBox[{"p", "[", "\[Theta]", "]"}]}], "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           SuperscriptBox["x", "2"], "->", 
