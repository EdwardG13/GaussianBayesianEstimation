Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "MSL", " ", "for", " ", "a", " ", "squeeed", " ", "displaced", " ", 
    "probe"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Normal", "[", 
    RowBox[{"Series", "[", 
     RowBox[{
      RowBox[{"MSL", "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Vxx", "->", 
          RowBox[{"Exp", "[", 
           RowBox[{"2", "r"}], "]"}]}], ",", 
         RowBox[{"Vpp", "->", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", "2"}], "r"}], "]"}]}], ",", 
         RowBox[{"\[Mu]x", "->", 
