Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Choose", " ", "a", " ", "Gaussian", " ", "prior", " ", "for", " ", 
    "simple", " ", "moments"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"p", "[", "\[Theta]_", "]"}], ":=", 
     RowBox[{"PDF", "[", 
      RowBox[{
       RowBox[{"NormalDistribution", "[", 
        RowBox[{"\[Mu]0", ",", "\[Sigma]0"}], "]"}], ",", "\[Theta]"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     SubscriptBox["\[Rho]", "0"], " ", "averages"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"avgx2\[Rho]0", "=", 
    RowBox[{
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         SuperscriptBox["x", "2"], "*", " ", 
         RowBox[{"p", "[", "\[Theta]", "]"}]}], "/.", 
        RowBox[{"{", 
         RowBox[{
          SuperscriptBox["x", "2"], "->", 
          RowBox[{
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{"-", "2"}], " ", "\[Theta]"}], "]"}], "Vxx"}]}], "}"}]}],
        ",", 
       RowBox[{"{", 
        RowBox[{"\[Theta]", ",", 
         RowBox[{"-", "Infinity"}], ",", "Infinity"}], "}"}], ",", 
       RowBox[{"Assumptions", "->", 
        RowBox[{"\[Sigma]0", ">", "0"}]}]}], "]"}], "//", "Simplify"}]}], "\[IndentingNewLine]", 
   RowBox[{"avgp2\[Rho]0", "=", 
    RowBox[{
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         SuperscriptBox["q", "2"], "*", " ", 
         RowBox[{"p", "[", "\[Theta]", "]"}]}], "/.", 
        RowBox[{"{", 
         RowBox[{
          SuperscriptBox["q", "2"], "->", 
          RowBox[{
           RowBox[{"Exp", "[", 
            RowBox[{"2", " ", "\[Theta]"}], "]"}], "Vpp"}]}], "}"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Theta]", ",", 
         RowBox[{"-", "Infinity"}], ",", "Infinity"}], "}"}], ",", 
       RowBox[{"Assumptions", "->", 
        RowBox[{"\[Sigma]0", ">", "0"}]}]}], "]"}], "//", "Simplify"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"2", "x2", " ", "Gram", " ", "matrix", " ", "block"}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"Gx2x2", "=", 
    RowBox[{
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Expand", "[", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{
             SuperscriptBox["x", "2"], "-", "avgx2\[Rho]0"}], ")"}], "2"], 
          "]"}], " ", 
         RowBox[{"p", "[", "\[Theta]", "]"}]}], "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           SuperscriptBox["x", "4"], "->", 
           RowBox[{"3", " ", 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"Vxx", " ", 
               RowBox[{"Exp", "[", 
                RowBox[{
                 RowBox[{"-", "2"}], " ", "\[Theta]"}], "]"}]}], ")"}], 
             "2"]}]}], ",", 
          RowBox[{
           SuperscriptBox["x", "2"], "->", 
           RowBox[{
            RowBox[{"Exp", "[", 
             RowBox[{
              RowBox[{"-", "2"}], " ", "\[Theta]"}], "]"}], "Vxx"}]}]}], 
         "}"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Theta]", ",", 
         RowBox[{"-", "Infinity"}], ",", "Infinity"}], "}"}], ",", 
       RowBox[{"Assumptions", "->", 
        RowBox[{"\[Sigma]0", ">", "0"}]}]}], "]"}], "//", "Simplify"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"Gp2p2", "=", 
    RowBox[{
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Expand", "[", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{
             SuperscriptBox["q", "2"], "-", "avgp2\[Rho]0"}], ")"}], "2"], 
          "]"}], " ", 
         RowBox[{"p", "[", "\[Theta]", "]"}]}], "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           SuperscriptBox["q", "4"], "->", 
           RowBox[{"3", " ", 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"Vpp", " ", 
               RowBox[{"Exp", "[", 
                RowBox[{"2", " ", "\[Theta]"}], "]"}]}], ")"}], "2"]}]}], ",", 
          RowBox[{
           SuperscriptBox["q", "2"], "->", 
           RowBox[{
            RowBox[{"Exp", "[", 
             RowBox[{"2", " ", "\[Theta]"}], "]"}], "Vpp"}]}]}], "}"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Theta]", ",", 
         RowBox[{"-", "Infinity"}], ",", "Infinity"}], "}"}], ",", 
       RowBox[{"Assumptions", "->", 
        RowBox[{"\[Sigma]0", ">", "0"}]}]}], "]"}], "//", "Simplify"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"Gx2p2", "=", 
    RowBox[{
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Expand", "[", 
          RowBox[{
           RowBox[{"Vxx", " ", "Vpp"}], "+", 
           RowBox[{"2", "*", 
            SuperscriptBox["Vxp", "2"]}], "-", 
