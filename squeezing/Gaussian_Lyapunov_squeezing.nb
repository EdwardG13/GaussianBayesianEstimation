Cell[BoxData[
 RowBox[{"Normal", "@", 
  RowBox[{"Series", "[", 
   RowBox[{
    RowBox[{"MSL1x\[Phi]2ZeroMean", "[", 
     RowBox[{
     "\[Phi]", ",", "\[Mu]0", ",", "\[Sigma]0", ",", "Vxx", ",", "Vpp"}], 
     "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"\[Sigma]0", ",", "0", ",", "4"}], "}"}]}], "]"}]}]], "Input",
