           Offset[0.2], {
            Offset[0.4]}, 
           Offset[0.2]}}], "\[NoBreak]", ")"}],
     Function[BoxForm`e$, 
      MatrixForm[BoxForm`e$]]]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Gmat", "//", "MatrixForm"}]}], "Input",
 CellChangeTimes->{{3.983603883457306*^9, 3.9836039744816513`*^9}, {
