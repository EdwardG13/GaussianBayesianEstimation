Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   RowBox[{"Compare", " ", "the", " ", "O", 
    RowBox[{"(", 
     SuperscriptBox[
      SubscriptBox["\[Sigma]", "0"], "4"], ")"}], " ", "with", " ", "the", " ",
     "Classical", " ", "Fisher", " ", "information", " ", "for", " ", 
    "zero"}], "-", 
   RowBox[{"mean", " ", "homodyne"}]}]],ExpressionUUID->
  "90a373e5-99dc-f743-a9a9-9db52b0ea628"],
 ".\nThis gives the likelihood ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"p", "(", 
     RowBox[{
      SubscriptBox["x", "\[Phi]"], "|", "\[Theta]"}], ")"}], "=", 
    RowBox[{"\[ScriptCapitalN]", "(", 
     RowBox[{"0", ",", 
      RowBox[{
       SubscriptBox["Var", "\[Phi]"], "(", "\[Theta]", ")"}]}], ")"}]}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e8ccd55c-340f-7d40-bcca-4f27886fc140"],
 " where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["Var", "\[Phi]"], "(", "\[Theta]", ")"}], "=", " ", 
    RowBox[{
     RowBox[{
      SubscriptBox["V", "xx"], 
      SuperscriptBox["e", 
       RowBox[{
        RowBox[{"-", "2"}], "\[Theta]"}]], 
      SuperscriptBox[
       RowBox[{"cos", "(", "\[Phi]", ")"}], "2"]}], "+", 
     RowBox[{
      SubscriptBox["V", "pp"], 
      SuperscriptBox["e", 
       RowBox[{"2", "\[Theta]"}]], 
      SuperscriptBox[
       RowBox[{"sin", "(", "\[Phi]", ")"}], "2"]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "bbe6db04-5718-ec4b-bb2e-d9857aa64885"]
}], "Text",
