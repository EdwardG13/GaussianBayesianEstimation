Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "The", " ", "CFI", " ", "here", " ", "comes", " ", "purely", " ", "from", 
     " ", "variance", " ", "encoding", " ", "CFI"}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          SubscriptBox["\[PartialD]", "\[Theta]"], " ", "Var"}], 
         SuperscriptBox[
          RowBox[{"(", "\[Theta]", ")"}], "2"]}], ")"}], "/", "2"}], "Var", 
      SuperscriptBox[
       RowBox[{"(", "\[Theta]", ")"}], "2"]}], 
     SubscriptBox["|", 
      RowBox[{"\[Theta]", "\[Rule]", 
       SubscriptBox["\[Mu]", "0"]}]]}]}], "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"FisherHomodyneZeroMean", "[", 
     RowBox[{"\[Phi]_", ",", "\[Mu]0_", ",", "Vxx_", ",", "Vpp_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"var", ",", "dvar"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"var", "=", 
        RowBox[{
         RowBox[{"Vxx", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", "2"}], "\[Mu]0"}], "]"}], " ", 
          SuperscriptBox[
           RowBox[{"Cos", "[", "\[Phi]", "]"}], "2"]}], "+", 
         RowBox[{"Vpp", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{"2", "\[Mu]0"}], "]"}], " ", 
          SuperscriptBox[
           RowBox[{"Sin", "[", "\[Phi]", "]"}], "2"]}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"dvar", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "2"}], " ", "Vxx", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", "2"}], "\[Mu]0"}], "]"}], " ", 
          SuperscriptBox[
           RowBox[{"Cos", "[", "\[Phi]", "]"}], "2"]}], "+", 
         RowBox[{"2", " ", "Vpp", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{"2", "\[Mu]0"}], "]"}], " ", 
          SuperscriptBox[
           RowBox[{"Sin", "[", "\[Phi]", "]"}], "2"]}]}]}], ";", 
       "\[IndentingNewLine]", 
       FractionBox[
        SuperscriptBox["dvar", "2"], 
        RowBox[{"2", " ", 
         SuperscriptBox["var", "2"]}]]}]}], "]"}]}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Verify", " ", "against", " ", "your", " ", "series", " ", 
     "coefficient"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"FisherHomodyneZeroMean", "[", 
      RowBox[{"\[Phi]", ",", "\[Mu]0", ",", "Vxx", ",", "Vpp"}], "]"}], "-", 
     FractionBox[
      RowBox[{"2", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"-", 
            SuperscriptBox["\[ExponentialE]", 
             RowBox[{"4", " ", "\[Mu]0"}]]}], " ", "Vpp"}], "+", "Vxx", "+", 
          RowBox[{
           SuperscriptBox["\[ExponentialE]", 
            RowBox[{"4", " ", "\[Mu]0"}]], " ", "Vpp", " ", 
           RowBox[{"Cos", "[", 
            RowBox[{"2", " ", "\[Phi]"}], "]"}]}], "+", 
          RowBox[{"Vxx", " ", 
           RowBox[{"Cos", "[", 
            RowBox[{"2", " ", "\[Phi]"}], "]"}]}]}], ")"}], "2"]}], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           SuperscriptBox["\[ExponentialE]", 
            RowBox[{"4", " ", "\[Mu]0"}]]}], " ", "Vpp"}], "-", "Vxx", "+", 
         RowBox[{
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{"4", " ", "\[Mu]0"}]], " ", "Vpp", " ", 
          RowBox[{"Cos", "[", 
           RowBox[{"2", " ", "\[Phi]"}], "]"}]}], "-", 
         RowBox[{"Vxx", " ", 
          RowBox[{"Cos", "[", 
           RowBox[{"2", " ", "\[Phi]"}], "]"}]}]}], ")"}], "2"]]}], 
    "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9838087188479557`*^9, 3.983808814743824*^9}, {
  3.983808918200428*^9, 3.9838090810319214`*^9}, {3.983810594367279*^9, 
