          RowBox[{"Vxx", "+", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"x0", "+", "\[Mu]0"}], ")"}], "2"]}], ")"}], "2"]}], 
       ")"}]}]}]]}], "}"}]], "Output",
 CellChangeTimes->{
  3.9821324596672707`*^9, {3.982132671620741*^9, 3.9821326943469486`*^9}, 
   3.9821329500677643`*^9, 3.9821358037400856`*^9, 3.982149542230379*^9, 
   3.982398199790819*^9, 3.9825976438692207`*^9, 3.9825979209944096`*^9},
