Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Now", " ", "calculate", " ", "the", " ", "constrained", " ", "MSL", " ", 
     "\[ScriptCapitalL]", 
     RowBox[{"(", 
      SubscriptBox["\[ScriptCapitalS]", "\[ScriptCapitalV]"], ")"}]}], "=", 
    RowBox[{"\[Lambda]", "-", 
     RowBox[{
      SuperscriptBox["b", "T"], 
      SuperscriptBox["G", 
       RowBox[{"-", "1"}]], "b"}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"\[Lambda]", "=", 
    RowBox[{
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{
        SuperscriptBox["\[Theta]", "2"], " ", 
        RowBox[{"p", "[", "\[Theta]", "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Theta]", ",", 
         RowBox[{"\[Mu]0", "-", 
          FractionBox["\[CapitalDelta]", "2"]}], ",", 
         RowBox[{"\[Mu]0", "+", 
          FractionBox["\[CapitalDelta]", "2"]}]}], "}"}], ",", 
       RowBox[{"Assumptions", "->", 
        RowBox[{"\[Sigma]0", ">", "0"}]}]}], "]"}], "//", "Simplify"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"MSL", "=", 
    RowBox[{
     RowBox[{"\[Lambda]", "-", 
      RowBox[{"bvec", ".", 
       RowBox[{"Inverse", "[", "Gmat", "]"}], ".", "bvec"}]}], "//", 
     "Simplify"}]}]}]}]], "Input",
