            RowBox[{"(", 
             RowBox[{"x0", "+", "\[Mu]0"}], ")"}], "2"], "+", 
           SuperscriptBox["\[Sigma]0", "2"]}], ")"}], "2"]}], ")"}]}]}]]}], 
  "}"}]], "Output",
 CellChangeTimes->{
  3.9821324596672707`*^9, {3.982132671620741*^9, 3.9821326943469486`*^9}, 
   3.9821329500677643`*^9, 3.9821358037400856`*^9, 3.982149542230379*^9, 
   3.982398199790819*^9, 3.9825976438692207`*^9, 3.982597920897688*^9},
 CellLabel->"Out[30]=",ExpressionUUID->"cee9eca1-5fb4-654b-9572-f6a0278e5a0d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\[Mu]0", ",", 
   FractionBox[
    RowBox[{"4", " ", "Vpp", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", " ", 
        SuperscriptBox["p0", "2"]}], "+", "Vpp"}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{"x0", "+", "\[Mu]0"}], ")"}], " ", 
     SuperscriptBox["\[Sigma]0", "2"]}], 
    RowBox[{
     RowBox[{"-", 
      FractionBox["1", "4"]}], "+", 
     RowBox[{"2", " ", "Vpp", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", " ", 
         SuperscriptBox["p0", "2"]}], "+", "Vpp"}], ")"}], " ", 
      RowBox[{"(", 
