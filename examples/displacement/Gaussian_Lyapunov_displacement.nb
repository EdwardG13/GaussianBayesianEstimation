Cell[CellGroupData[{

Cell["\<\
Showing that the posterior mean for uniform prior only contains odd powers of \
x\
\>", "Section",
 CellChangeTimes->{{3.9800641916158295`*^9, 3.9800641997729607`*^9}, 
   3.9821318203727875`*^9, {3.9821354050378075`*^9, 3.9821354289465313`*^9}, {
   3.98239800613912*^9, 3.9823980065618153`*^9}, {3.982398526369898*^9, 
   3.9823985333845577`*^9}, {3.982398601187872*^9, 3.9823986221109447`*^9}, {
   3.9823986543019466`*^9, 3.982398659223215*^9}, {3.98291887018836*^9, 
   3.9829188878737946`*^9}},ExpressionUUID->"56c4c307-20a0-6846-aa63-\
b2bce1e721d2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"p", "[", "\[Theta]_", "]"}], ":=", 
   RowBox[{"PDF", "[", 
    RowBox[{
     RowBox[{"UniformDistribution", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Mu]0", "-", 
         FractionBox["\[CapitalDelta]", "2"]}], ",", 
        RowBox[{"\[Mu]0", "+", 
         FractionBox["\[CapitalDelta]", "2"]}]}], "}"}], "]"}], ",", 
     "\[Theta]"}], "]"}]}], " ", 
  RowBox[{"(*", 
   RowBox[{"Uniform", " ", "prior"}], " ", "*)"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"likelihood", "[", 
     RowBox[{"\[Theta]_", ",", "x_", ",", "x0_"}], "]"}], ":=", 
    RowBox[{"PDF", "[", 
     RowBox[{
      RowBox[{"NormalDistribution", "[", 
       RowBox[{
        RowBox[{"x0", "+", "\[Theta]"}], ",", "Vxx"}], "]"}], ",", "x"}], 
     "]"}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Gaussian", " ", "likelihood", " ", "of", " ", "x"}], "-", 
    RowBox[{"homodyne", " ", 
     RowBox[{"measurements", ".", " ", "This"}], " ", "comes", " ", "the", " ",
      "p"}], "-", 
    RowBox[{"marginal", " ", "of", " ", "the", " ", 
     RowBox[{"(", "Gaussian", ")"}], " ", "Wigner", " ", "function"}]}], " ", 
   "*)"}]}]}], "Input",
 CellChangeTimes->{{3.982397653610895*^9, 3.982397712255142*^9}, {
  3.9823978018341885`*^9, 3.982397801938492*^9}, {3.982398488403612*^9, 
  3.9823984916827545`*^9}, {3.9823985402349815`*^9, 3.9823985955301323`*^9}, {
  3.9829175350007496`*^9, 3.982917535417858*^9}, {3.9829175872134132`*^9, 
  3.9829175904431*^9}},
 CellLabel->
  "In[454]:=",ExpressionUUID->"25a1bf24-f943-c641-8334-c197367554c0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"evidence", "=", 
  RowBox[{"Integrate", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"likelihood", "[", 
      RowBox[{"\[Theta]", ",", "x", ",", "x0"}], "]"}], "*", 
     RowBox[{"p", "[", "\[Theta]", "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"\[Theta]", ",", 
      RowBox[{"-", "Infinity"}], ",", "Infinity"}], "}"}], ",", 
    RowBox[{"Assumptions", "->", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Sigma]0", ",", "Vxx", ",", "\[CapitalDelta]"}], "}"}], " ", 
      "\[Element]", " ", "PositiveReals"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9823977187049828`*^9, 3.982397791191717*^9}, {
   3.9823984810204563`*^9, 3.982398482043375*^9}, 3.9823986672399273`*^9, {
   3.982917607521641*^9, 3.982917610178177*^9}},
 CellLabel->
  "In[457]:=",ExpressionUUID->"314eb25f-bf91-b54a-bf93-ecd0597624a4"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   RowBox[{"Erf", "[", 
    FractionBox[
     RowBox[{
      RowBox[{"2", " ", "x"}], "-", 
      RowBox[{"2", " ", "x0"}], "+", "\[CapitalDelta]", "-", 
      RowBox[{"2", " ", "\[Mu]0"}]}], 
     RowBox[{"2", " ", 
      SqrtBox["2"], " ", "Vxx"}]], "]"}], "+", 
   RowBox[{"Erf", "[", 
    FractionBox[
     RowBox[{
      RowBox[{
       RowBox[{"-", "2"}], " ", "x"}], "+", 
      RowBox[{"2", " ", "x0"}], "+", "\[CapitalDelta]", "+", 
      RowBox[{"2", " ", "\[Mu]0"}]}], 
     RowBox[{"2", " ", 
      SqrtBox["2"], " ", "Vxx"}]], "]"}]}], 
  RowBox[{"2", " ", "\[CapitalDelta]"}]]], "Output",
 CellChangeTimes->{{3.9823977839907703`*^9, 3.9823978094057255`*^9}, 
   3.9823985010195293`*^9, 3.9823986704537544`*^9, 3.982917437606369*^9, 
   3.9829175715972214`*^9, {3.9829176063029118`*^9, 3.9829176165004387`*^9}},
 CellLabel->
  "Out[457]=",ExpressionUUID->"52289f2e-5d7b-1947-97fd-c9a079e303b3"]
}, Open  ]],

