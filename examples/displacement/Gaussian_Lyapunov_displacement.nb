Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"p", "[", "\[Theta]_", "]"}], ":=", 
    FractionBox["1", "\[CapitalDelta]"]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"Uniform", " ", "prior"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"avgx0", "=", 
    RowBox[{"Integrate", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"x0", "+", "\[Theta]"}], ")"}], " ", 
       RowBox[{"p", "[", "\[Theta]", "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Theta]", ",", 
        RowBox[{"\[Mu]0", "-", 
         FractionBox["\[CapitalDelta]", "2"]}], ",", 
        RowBox[{"\[Mu]0", "+", 
         FractionBox["\[CapitalDelta]", "2"]}]}], "}"}], ",", 
      RowBox[{"Assumptions", "->", 
       RowBox[{"\[CapitalDelta]", ">", "0"}]}]}], "]"}]}], " ", ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"B1", "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"B2", "=", 
    RowBox[{"x", "-", "avgx0"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"B3", "=", 
  RowBox[{"Collect", "[", 
   RowBox[{
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"x", "-", "avgx0"}], ")"}], "3"], "-", 
     RowBox[{
      RowBox[{"Simplify", "[", 
       FractionBox[
        RowBox[{"Integrate", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"Expand", "[", 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{"x", "-", "avgx0"}], ")"}], "4"], "]"}], ")"}], " ", 
            RowBox[{"p", "[", "\[Theta]", "]"}]}], "/.", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              SuperscriptBox["x", "4"], "->", 
              RowBox[{
               SuperscriptBox[
                RowBox[{"(", 
                 RowBox[{"x0", "+", "\[Theta]"}], ")"}], "4"], "+", 
               RowBox[{"6", "*", 
                SuperscriptBox[
                 RowBox[{"(", 
                  RowBox[{"x0", "+", "\[Theta]"}], ")"}], "2"], "*", "Vxx"}], 
               "+", 
               RowBox[{"3", "*", 
                SuperscriptBox["Vxx", "2"]}]}]}], ",", 
             RowBox[{
              SuperscriptBox["x", "3"], "->", 
              RowBox[{
               SuperscriptBox[
                RowBox[{"(", 
                 RowBox[{"x0", "+", "\[Theta]"}], ")"}], "3"], "+", 
               RowBox[{"3", "*", 
                RowBox[{"(", 
                 RowBox[{"x0", "+", "\[Theta]"}], ")"}], "*", "Vxx"}]}]}], ",", 
             RowBox[{
              SuperscriptBox["x", "2"], "->", 
              RowBox[{
               SuperscriptBox[
                RowBox[{"(", 
                 RowBox[{"x0", "+", "\[Theta]"}], ")"}], "2"], "+", "Vxx"}]}],
              ",", 
             RowBox[{"x", "->", 
              RowBox[{"(", 
               RowBox[{"x0", "+", "\[Theta]"}], ")"}]}]}], "}"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"\[Theta]", ",", 
            RowBox[{"\[Mu]0", "-", 
             FractionBox["\[CapitalDelta]", "2"]}], ",", 
            RowBox[{"\[Mu]0", "+", 
             FractionBox["\[CapitalDelta]", "2"]}]}], "}"}], ",", 
          RowBox[{"Assumptions", "->", 
           RowBox[{"\[CapitalDelta]", ">", "0"}]}]}], "]"}], 
        RowBox[{"Integrate", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"Expand", "[", 
              SuperscriptBox[
