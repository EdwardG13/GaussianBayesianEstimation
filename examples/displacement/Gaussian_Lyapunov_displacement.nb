         RowBox[{"(", 
          RowBox[{"Vxx", "+", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"x0", "+", "\[Mu]0"}], ")"}], "2"]}], ")"}], "2"]}], 
       ")"}]}]}]], ",", 
   FractionBox[
    RowBox[{
     RowBox[{"(", 
      RowBox[{"x0", "+", "\[Mu]0"}], ")"}], " ", 
     SuperscriptBox["\[Sigma]0", "2"]}], 
    RowBox[{
     RowBox[{"-", 
      FractionBox["1", "4"]}], "+", 
     RowBox[{"2", " ", "Vpp", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", " ", 
         SuperscriptBox["p0", "2"]}], "+", "Vpp"}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["p0", "4"], "+", 
        RowBox[{"6", " ", 
         SuperscriptBox["p0", "2"], " ", "Vpp"}], "+", 
        RowBox[{"3", " ", 
         SuperscriptBox["Vpp", "2"]}], "-", 
