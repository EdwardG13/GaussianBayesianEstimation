Cell[TextData[{
 "This means that the basis which makes ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["G", "ij"], "=", 
    SubscriptBox[
     RowBox[{"\[LeftAngleBracket]", 
      RowBox[{
       SubscriptBox["B", "i"], ",", 
       SubscriptBox["B", "j"]}], "\[RightAngleBracket]"}], 
     SubscriptBox["\[Rho]", "0"]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "553ad407-37b1-0c4c-a53e-1ff80bca3ac2"],
 " diagonal is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "\[CapitalDelta]x", ",", " ", 
     RowBox[{
      SuperscriptBox["\[CapitalDelta]x", "2"], "-", 
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["V", "xx"], "+", 
        SuperscriptBox[
         SubscriptBox["\[Sigma]", "0"], "2"]}]}]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "dfbd548d-a14f-374e-b2d1-fa8fd22c9c3e"],
 ")} where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[CapitalDelta]x", "2"], "=", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       OverscriptBox["x", "^"], "-", 
       SubscriptBox[
        RowBox[{"\[LeftAngleBracket]", "x", "\[RightAngleBracket]"}], 
        SubscriptBox["\[Rho]", "0"]]}], ")"}], "2"]}], TraditionalForm]],
  ExpressionUUID->"227be7b1-1b19-2344-b13c-2ea61a6356b9"],
 "."
}], "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.9832515256466217`*^9, 3.983251648970976*^9}},
 Background->RGBColor[
  0.67, 0.54, 0.42, 
   0.33],ExpressionUUID->"b47037ab-dfb7-fe4f-93e0-fcca0e1c221e"],

