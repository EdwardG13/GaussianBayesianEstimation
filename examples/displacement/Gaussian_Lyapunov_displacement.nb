             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{"x0", "+", "\[Theta]"}], ")"}], "2"], "+", "Vxx"}]}], ",", 
           RowBox[{"x", "->", 
            RowBox[{"(", 
             RowBox[{"x0", "+", "\[Theta]"}], ")"}]}]}], "}"}]}], ",", 
