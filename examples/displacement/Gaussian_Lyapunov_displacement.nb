Cell[BoxData[{
 RowBox[{
  RowBox[{"B1", "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"B2", "=", 
    RowBox[{"x", "-", "avgx0"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"B3", "=", 
  RowBox[{"Collect", "[", 
