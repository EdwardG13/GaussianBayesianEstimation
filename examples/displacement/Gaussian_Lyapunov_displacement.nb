Cell[CellGroupData[{

Cell["\<\
Showing that the posterior mean is the same linear shrinkage estimator \
\>", "Section",
 CellChangeTimes->{{3.9800641916158295`*^9, 3.9800641997729607`*^9}, 
   3.9821318203727875`*^9, {3.9821354050378075`*^9, 3.9821354289465313`*^9}, {
   3.98239800613912*^9, 3.9823980065618153`*^9}, {3.982398526369898*^9, 
   3.9823985333845577`*^9}, {3.982398601187872*^9, 3.9823986221109447`*^9}, {
   3.9823986543019466`*^9, 
   3.982398659223215*^9}},ExpressionUUID->"eb2d9ddd-b8a4-ee49-b381-\
a864172b83a6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"p", "[", "\[Theta]_", "]"}], ":=", 
    RowBox[{"PDF", "[", 
     RowBox[{
      RowBox[{"NormalDistribution", "[", 
       RowBox[{"\[Mu]0", ",", "\[Sigma]0"}], "]"}], ",", "\[Theta]"}], 
     "]"}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{"Gaussian", " ", "prior"}], " ", "*)"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"likelihood", "[", 
     RowBox[{"\[Theta]_", ",", "x_", ",", "x0_"}], "]"}], ":=", 
    RowBox[{"PDF", "[", 
     RowBox[{
      RowBox[{"NormalDistribution", "[", 
       RowBox[{
        RowBox[{"x0", "+", "\[Theta]"}], ",", "Vxx"}], "]"}], ",", "x"}], 
     "]"}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Gaussian", " ", "likelihood", " ", "of", " ", "x"}], "-", 
    RowBox[{"homodyne", " ", 
     RowBox[{"measurements", ".", " ", "This"}], " ", "comes", " ", "the", " ",
      "p"}], "-", 
    RowBox[{"marginal", " ", "of", " ", "the", " ", 
     RowBox[{"(", "Gaussian", ")"}], " ", "Wigner", " ", "function"}]}], " ", 
   "*)"}]}]}], "Input",
 CellChangeTimes->{{3.982397653610895*^9, 3.982397712255142*^9}, {
  3.9823978018341885`*^9, 3.982397801938492*^9}, {3.982398488403612*^9, 
  3.9823984916827545`*^9}, {3.9823985402349815`*^9, 3.9823985955301323`*^9}, {
  3.9829175350007496`*^9, 3.982917535417858*^9}},
 CellLabel->
  "In[451]:=",ExpressionUUID->"23200085-6bc0-9440-83a0-707c92b5ac89"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"evidence", "=", 
  RowBox[{"Integrate", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"likelihood", "[", 
      RowBox[{"\[Theta]", ",", "x", ",", "x0"}], "]"}], "*", 
     RowBox[{"p", "[", "\[Theta]", "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"\[Theta]", ",", 
      RowBox[{"-", "Infinity"}], ",", "Infinity"}], "}"}], ",", 
    RowBox[{"Assumptions", "->", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Sigma]0", ",", "Vxx"}], "}"}], " ", "\[Element]", " ", 
      "PositiveReals"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9823977187049828`*^9, 3.982397791191717*^9}, {
   3.9823984810204563`*^9, 3.982398482043375*^9}, 3.9823986672399273`*^9},
 CellLabel->
  "In[453]:=",ExpressionUUID->"a97c3f02-c9bc-d145-8379-664b12b85427"],

Cell[BoxData[
 FractionBox[
  SuperscriptBox["\[ExponentialE]", 
   RowBox[{"-", 
    FractionBox[
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "x"}], "+", "x0", "+", "\[Mu]0"}], ")"}], "2"], 
     RowBox[{"2", " ", 
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["Vxx", "2"], "+", 
        SuperscriptBox["\[Sigma]0", "2"]}], ")"}]}]]}]], 
  RowBox[{
   SqrtBox[
    RowBox[{"2", " ", "\[Pi]"}]], " ", 
