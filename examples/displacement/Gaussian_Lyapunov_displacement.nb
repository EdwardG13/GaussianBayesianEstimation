           RowBox[{"Expand", "[", 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"x", "-", "avgx0"}], ")"}], "2"], "]"}], ")"}], " ", 
          RowBox[{"p", "[", "\[Theta]", "]"}]}], "/.", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            SuperscriptBox["x", "2"], "->", 
